{
  "name": "ar-app",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node --env-file-if-exists=.env server/node.mjs",
    "dev:all": "concurrently -n server,client -c yellow,cyan \"npm:server\" \"npm:dev\"",
    "tunnel": "cloudflared tunnel --url http://localhost:5173",
    "build": "vite build",
    "build:check": "npm run build && node scripts/check-build-budgets.mjs",
    "targets:generate-llm-refs": "node scripts/generate-llm-reference-images.mjs",
    "assets:report": "node scripts/report-assets.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.3.4",
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.7",
    "mind-ar": "^1.1.5",
    "openai": "^7.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.23.1",
    "three": "0.151.3"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/cli": "^8.5.1",
    "@vitejs/plugin-react": "4.3.1",
    "concurrently": "^10.0.5",
    "sharp": "^0.35.4",
    "vite": "5.3.1"
  }
}
