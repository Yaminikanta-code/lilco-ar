# Card-classification backend (server/app.mjs) — set these as secrets in your
# hosting provider's dashboard (Netlify env vars, etc.), never commit real values.

# Required. API key for the LLM provider.
LLM_API_KEY=

# Optional. Leave unset to use OpenAI directly. Set to an OpenAI-compatible
# endpoint to use a different provider, e.g. Google Gemini:
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_BASE_URL=

# Optional. Defaults to gpt-4o-mini. For Gemini via the compat endpoint above,
# use a Gemini model name instead, e.g. gemini-2.5-flash.
LLM_MODEL=
